# Control de abusos (Mensajes por ventana en segundos)
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=60

# HuggingFace (generación de imágenes) — Token gratuito de https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_tu_token_aqui
